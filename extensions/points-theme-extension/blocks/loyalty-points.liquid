<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('loyalty-modal');
    const openBtn = document.getElementById('open-loyalty-modal');
    const closeBtn = document.getElementById('close-loyalty-modal');

    // UI Toggle events
    if (openBtn && modal) {
      openBtn.addEventListener('click', () => modal.classList.add('is-open'));
    }
    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => modal.classList.remove('is-open'));
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('is-open');
      });
    }

    // Logic for Points Panel if customer session exists
    const radioYes = document.getElementById('use-points-yes');
    const radioNo = document.getElementById('use-points-no');
    const sliderPanel = document.getElementById('el-slider-panel');
    const slider = document.getElementById('el-points-slider');
    const pointsValText = document.getElementById('el-slider-points-val');
    const monetaryValText = document.getElementById('el-slider-monetary-val');
    const pointsNumber = document.getElementById('points-number');

    const redeemBtn = document.getElementById("el-redeem-btn");
    const statusMsg = document.getElementById("el-status-message");
    
    const customerEmail = {{ customer.email | json }};
    const shopDomain = {{ shop.permanent_domain | json }};
    const BASE_API = "https://regina-cycadlike-senatorially.ngrok-free.dev";

    if (customerEmail) {
      fetch(`${BASE_API}/api/loyalty/get-points?email=${encodeURIComponent(customerEmail)}&shop=${shopDomain}`, {
        method: "GET",   
        headers: {
          "ngrok-skip-browser-warning": "true",
          "Accept": "application/json",
          "Content-Type": "application/json"
        }
      })
      .then(res => {
        if (!res.ok) throw new Error(`HTTP error status ${res.status}`);
        return res.json();
      })
      .then(data => {
        const livePoints = data.points || 0;
        console.log(`[ODOO FETCH SUCCESS] Live balance: ${livePoints}`);
        if (pointsNumber) pointsNumber.textContent = livePoints;
        
        if (slider) {
          // ⭐ FIXED: Removed the stray "i" text variable token causing the crash
          slider.max = livePoints; 
          
          if (Number(livePoints) < 20) {
            slider.min = "0";
            slider.value = String(livePoints);
            if (pointsValText) pointsValText.textContent = livePoints;
            if (monetaryValText) monetaryValText.textContent = (livePoints / 20).toFixed(2);
          } else {
            slider.min = "20";
            slider.value = "20"; // Defaults slider position to baseline redemption unit
            if (pointsValText) pointsValText.textContent = "20";
            if (monetaryValText) monetaryValText.textContent = "1.00";
          }
        }
      })
      .catch(err => console.error("Error fetching live Odoo points:", err));
    }

    if (radioYes && radioNo && sliderPanel) {
      const toggleSliderView = () => {
        sliderPanel.style.display = radioYes.checked ? 'block' : 'none';
      };

      radioYes.addEventListener('change', toggleSliderView);
      radioNo.addEventListener('change', toggleSliderView);

      if (slider) {
        slider.addEventListener('input', function() {
          const currentPoints = this.value;
          const dynamicCashback = (parseFloat(currentPoints) / 20).toFixed(2);
          
          if (pointsValText) pointsValText.textContent = currentPoints;
          if (monetaryValText) monetaryValText.textContent = dynamicCashback;
        });
      }
    }

    if (redeemBtn) {
      redeemBtn.addEventListener("click" , async () => {
        if (!radioYes.checked) {
          alert("Please apply rewards to acquisition first.");
          return;
        }       

        const selectedPoints = Number(slider.value);
        if (!selectedPoints || selectedPoints < 20) {
          alert("Minimum target should be 20 points.");
          return;
        }
        
        redeemBtn.disabled = true;
        redeemBtn.textContent = "Generating reward...";

        if (statusMsg) {
          statusMsg.style.display = "block";
          statusMsg.style.color = "gray";
          statusMsg.textContent = "Processing points validation..."; // FIXED: Cleaned up placeholder typo string
        }

        try {
          const response = await fetch(`${BASE_API}/api/loyalty/redeem` , {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "ngrok-skip-browser-warning": "true",
              "Accept": "application/json"
            },
            body: JSON.stringify({
              email: customerEmail,
              shop: shopDomain,
              points: selectedPoints
            })
          });

          const result = await response.json();
          
          // ⭐ FIXED: Swapped result.sucess to result.success to accurately catch backend response mapping
          if (result.success && result.discountCode) {
            statusMsg.style.color = "var(--el-gold)";
            statusMsg.textContent = `Success! Code ${result.discountCode} created.`;

            // ⭐ FIXED: Prefixed absolute path forward slash to load the URL properly
            fetch(`/discount/${result.discountCode}`)
              .then(() => {
                statusMsg.textContent = "Discount Applied! Reloading page context...";
                setTimeout(() => {
                  window.location.reload();
                }, 1000);
              });
          } else {
            throw new Error(result.error || "Failed to issue coupon code instance.");
          }
        } catch (err) {
          console.error("❌ Redemption Pipeline crashed:", err);
          statusMsg.style.color = "red";
          statusMsg.textContent = err.message || "Error setting calculation values.";
          redeemBtn.disabled = false;
          redeemBtn.textContent = "Apply Coupon to Cart";
        }
      });
    }
  });
</script>


