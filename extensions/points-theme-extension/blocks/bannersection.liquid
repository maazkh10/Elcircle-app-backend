<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="{{ 'bannersection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Luxury Lookbook Slider",
  "target": "section",
  "settings": [
    { "type": "text", "id": "watermark_text", "label": "Watermark Text", "default": "88" },
    { "type": "text", "id": "micro_label", "label": "Micro Label", "default": "EL CIRCLE 88 • MEMBERSHIP ECOSYSTEM" },
    { "type": "text", "id": "main_title_line_1", "label": "Main Title (Line 1)", "default": "Elevate Your" },
    { "type": "text", "id": "main_title_line_2", "label": "Main Title (Line 2)", "default": "Status & Privileges" },
    { "type": "textarea", "id": "main_description", "label": "Main Description", "default": "Unlock unprecedented access, curated lifestyle rewards, and tailored atelier experiences as you progress through our ultra-luxury tier hierarchy." },

    { "type": "text", "id": "title_pearl", "label": "01. Pearl Title", "default": "Pearl Tier" },
    { "type": "text", "id": "tag_pearl", "label": "01. Pearl Tag", "default": "Entry Elite" },
    { "type": "textarea", "id": "desc_pearl", "label": "01. Pearl Description", "default": "Complimentary global concierge consultation, foundational event entry, and baseline points multiplier." },
    { "type": "image_picker", "id": "card_img_pearl", "label": "01. Pearl Card Graphic" },
    { "type": "image_picker", "id": "bg_img_pearl", "label": "01. Pearl Background Photo" },

    { "type": "text", "id": "title_silver", "label": "02. Silver Title", "default": "Silver Tier" },
    { "type": "text", "id": "tag_silver", "label": "02. Silver Tag", "default": "Requires 5,000 pts" },
    { "type": "textarea", "id": "desc_silver", "label": "02. Silver Description", "default": "Priority bespoke adjustments, 1.2x tier points multi, and access to regional private member showrooms." },
    { "type": "image_picker", "id": "card_img_silver", "label": "02. Silver Card Graphic" },
    { "type": "image_picker", "id": "bg_img_silver", "label": "02. Silver Background Photo" },

    { "type": "text", "id": "title_gold", "label": "03. Gold Title", "default": "Gold Tier" },
    { "type": "text", "id": "tag_gold", "label": "03. Gold Tag", "default": "Requires 15,000 pts" },
    { "type": "textarea", "id": "desc_gold", "label": "03. Gold Description", "default": "Dedicated personal style curator, 1.5x multi, complimentary seasonal gifts, and private runway pre-sales." },
    { "type": "image_picker", "id": "card_img_gold", "label": "03. Gold Card Graphic" },
    { "type": "image_picker", "id": "bg_img_gold", "label": "03. Gold Background Photo" },

    { "type": "text", "id": "title_platinum", "label": "04. Platinum Title", "default": "Platinum Tier" },
    { "type": "text", "id": "tag_platinum", "label": "04. Platinum Tag", "default": "Requires 35,000 pts" },
    { "type": "textarea", "id": "desc_platinum", "label": "04. Platinum Description", "default": "2.0x points accumulation, complete access to local club lounges, and tailored sizing fitting vault integration." },
    { "type": "image_picker", "id": "card_img_platinum", "label": "04. Platinum Card Graphic" },
    { "type": "image_picker", "id": "bg_img_platinum", "label": "04. Platinum Background Photo" },

    { "type": "text", "id": "title_diamond", "label": "05. Diamond Title", "default": "Diamond Tier" },
    { "type": "text", "id": "tag_diamond", "label": "05. Diamond Tag", "default": "Requires 75,000 pts" },
    { "type": "textarea", "id": "desc_diamond", "label": "05. Diamond Description", "default": "Private flight partner upgrades, invite-only international design weeks, and 24/7 hyper-priority fulfillment." },
    { "type": "image_picker", "id": "card_img_diamond", "label": "05. Diamond Card Graphic" },
    { "type": "image_picker", "id": "bg_img_diamond", "label": "05. Diamond Background Photo" },

    { "type": "text", "id": "title_emerald", "label": "06. Emerald Title", "default": "Emerald Tier" },
    { "type": "text", "id": "tag_emerald", "label": "06. Emerald Tag", "default": "Requires 150,000 pts" },
    { "type": "textarea", "id": "desc_emerald", "label": "06. Emerald Description", "default": "Uncapped multipliers, tailored luxury brand cross-gifting, and annual all-inclusive atelier retreats." },
    { "type": "image_picker", "id": "card_img_emerald", "label": "06. Emerald Card Graphic" },
    { "type": "image_picker", "id": "bg_img_emerald", "label": "06. Emerald Background Photo" },

    { "type": "text", "id": "title_ruby", "label": "07. Ruby Title", "default": "Ruby Tier" },
    { "type": "text", "id": "tag_ruby", "label": "07. Ruby Tag", "default": "Requires 300,000 pts" },
    { "type": "textarea", "id": "desc_ruby", "label": "07. Ruby Description", "default": "Direct access to lead creative directors, fully personalized custom fabric milling options, and bespoke private galas." },
    { "type": "image_picker", "id": "card_img_ruby", "label": "07. Ruby Card Graphic" },
    { "type": "image_picker", "id": "bg_img_ruby", "label": "07. Ruby Background Photo" },

    { "type": "text", "id": "title_infinite", "label": "08. Infinite Title", "default": "Infinite Tier" },
    { "type": "text", "id": "tag_infinite", "label": "08. Infinite Tag", "default": "By Invitation Only" },
    { "type": "textarea", "id": "desc_infinite", "label": "08. Infinite Description", "default": "The absolute pinnacle. Custom-designed metal credentials, lifetime bespoke allocations, and sovereign asset management privileges." },
    { "type": "image_picker", "id": "card_img_infinite", "label": "08. Infinite Card Graphic" },
    { "type": "image_picker", "id": "bg_img_infinite", "label": "08. Infinite Background Photo" }
  ]
}
{% endschema %}
