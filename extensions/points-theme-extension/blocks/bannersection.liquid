{{ 'bannersection.css' | asset_url | stylesheet_tag }}

<div class="noir-editorial-shell" id="EditorialSlider-{{ block.id }}">
  <div class="noir-ambient-light"></div>
  <div class="noir-floating-mark">{{ block.settings.watermark_text }}</div>

  <div class="noir-left-column">
    <div class="noir-content-wrap">
      <div class="noir-micro-label">{{ block.settings.micro_label }}</div>
      <h2 class="noir-main-title">
        {{ block.settings.main_title_line_1 }}
        <span>{{ block.settings.main_title_line_2 }}</span>
      </h2>

      <p class="noir-description">
        {{ block.settings.main_description }}
      </p>

      <div class="noir-slider-stage">

        <div class="noir-slide active-slide">
          <div class="noir-slide-layout-box">
            <div class="noir-slide-image-wrap">
              {% if block.settings.card_img_pearl != blank %}
                <img src="{{ block.settings.card_img_pearl | image_url: width: 1000 }}" alt="{{ block.settings.title_pearl | escape }}" class="luxury-card-img" loading="eager">
              {% else %}
                <div class="luxury-card-fallback">
                  <img src="https://cdn.shopify.com/s/files/1/0649/2838/3074/files/ElCircle88_membership_card_diamond.png?v=1782387285" alt="Pearl Tier Card" class="luxury-card-img" loading="eager">
                </div>
              {% endif %}
              <div class="noir-image-overlay"></div>
            </div>
            <div class="noir-slide-bottom">
              <div>
                <span class="noir-slide-index">01 / 08</span>
                <h3 class="noir-slide-title">{{ block.settings.title_pearl }}</h3>
              </div>
              {% if block.settings.tag_pearl != blank %}
                <span class="noir-slide-tag">{{ block.settings.tag_pearl }}</span>
              {% endif %}
            </div>
            <p class="tier-perks-summary">{{ block.settings.desc_pearl }}</p>
          </div>
        </div>


        <div class="noir-slide">

        <div class="noir-slide-layout-box">

          <div class="noir-slide-image-wrap">

            {% if block.settings.card_img_silver != blank %}

                <img src="{{ block.settings.card_img_silver | image_url: width: 1000 }}" alt="{{ block.settings.title_silver | escape }}" class="luxury-card-img" loading="lazy">

                {% else %}

              <div class="luxury-card-fallback">

                <img src="https://cdn.shopify.com/s/files/1/0649/2838/3074/files/ElCircle88_membership_card_pearl.ai?v=1782385031" alt="Silver Tier Card" class="luxury-card-img" loading="lazy">

                  </div>
              {% endif %}
              <div class="noir-image-overlay"></div>
            </div>
            <div class="noir-slide-bottom">
              <div>
                <span class="noir-slide-index">02 / 08</span>
                <h3 class="noir-slide-title">{{ block.settings.title_silver }}</h3>
              </div>
              {% if block.settings.tag_silver != blank %}
                <span class="noir-slide-tag">{{ block.settings.tag_silver }}</span>
              {% endif %}
            </div>
            <p class="tier-perks-summary">{{ block.settings.desc_silver }}</p>
          </div>
        </div>


        <div class="noir-slide">
          <div class="noir-slide-layout-box">
            <div class="noir-slide-image-wrap">
              {% if block.settings.card_img_gold != blank %}
                <img src="{{ block.settings.card_img_gold | image_url: width: 1000 }}" alt="{{ block.settings.title_gold | escape }}" class="luxury-card-img" loading="lazy">
              {% else %}
                <div class="luxury-card-fallback">
                  <img src="https://cdn.shopify.com/s/files/1/0649/2838/3074/files/ElCircle88_membership_card_pearl.ai?v=1782385031" alt="Gold Tier Card" class="luxury-card-img" loading="lazy">
                </div>
              {% endif %}
              <div class="noir-image-overlay"></div>
            </div>
            <div class="noir-slide-bottom">
