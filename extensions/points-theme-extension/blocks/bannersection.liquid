                </div>
              {% endif %}
              <div class="noir-image-overlay"></div>
            </div>
            <div class="noir-slide-bottom">
              <div>
                <span class="noir-slide-index">07 / 08</span>
                <h3 class="noir-slide-title">{{ block.settings.title_ruby }}</h3>
              </div>
              {% if block.settings.tag_ruby != blank %}
                <span class="noir-slide-tag">{{ block.settings.tag_ruby }}</span>
              {% endif %}
            </div>
            <p class="tier-perks-summary">{{ block.settings.desc_ruby }}</p>
          </div>
        </div>


        <div class="noir-slide">
          <div class="noir-slide-layout-box">
            <div class="noir-slide-image-wrap">
              {% if block.settings.card_img_infinite != blank %}
                <img src="{{ block.settings.card_img_infinite | image_url: width: 1000 }}" alt="{{ block.settings.title_infinite | escape }}" class="luxury-card-img" loading="lazy">
              {% else %}
                <div class="luxury-card-fallback">
                  <img src="https://cdn.shopify.com/s/files/1/0649/2838/3074/files/ElCircle88_membership_card_pearl.ai?v=1782385031" alt="Infinite Tier Card" class="luxury-card-img" loading="lazy">
                </div>
              {% endif %}
              <div class="noir-image-overlay"></div>
            </div>
            <div class="noir-slide-bottom">
              <div>
                <span class="noir-slide-index">08 / 08</span>
                <h3 class="noir-slide-title">{{ block.settings.title_infinite }}</h3>
              </div>
              {% if block.settings.tag_infinite != blank %}
                <span class="noir-slide-tag">{{ block.settings.tag_infinite }}</span>
              {% endif %}
            </div>
            <p class="tier-perks-summary">{{ block.settings.desc_infinite }}</p>
          </div>
        </div>
      </div>

      <div class="noir-nav">
        <button class="noir-nav-btn prev-btn" type="button">←</button>
        <div class="noir-progress-line">
          <div class="noir-progress-fill"></div>
        </div>
        <button class="noir-nav-btn next-btn" type="button">→</button>
      </div>
    </div>
  </div>

  <div class="noir-right-column">
    <div class="noir-right-image-shell">
      <div class="noir-right-image-frame">

        {% if block.settings.bg_img_pearl != blank %}
          <img src="{{ block.settings.bg_img_pearl | image_url: width: 1600 }}" class="noir-bg-image" alt="{{ block.settings.title_pearl | escape }}" loading="eager">
        {% else %}
          <img src="https://images.unsplash.com/photo-1549298916-b41d501d3772?q=80&w=1600" class="noir-bg-image" alt="Pearl Lifestyle" loading="eager">
        {% endif %}


        {% if block.settings.bg_img_silver != blank %}
          <img src="{{ block.settings.bg_img_silver | image_url: width: 1600 }}" class="noir-bg-image" alt="{{ block.settings.title_silver | escape }}" loading="lazy">
        {% else %}
          <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=1600" class="noir-bg-image" alt="Silver Lifestyle" loading="lazy">
