              </div>
              {% if block.settings.tag_diamond != blank %}
                <span class="noir-slide-tag">{{ block.settings.tag_diamond }}</span>
              {% endif %}
            </div>
            <p class="tier-perks-summary">{{ block.settings.desc_diamond }}</p>
          </div>
        </div>


        <div class="noir-slide">
          <div class="noir-slide-layout-box">
