          </div>
        </div>


        <div class="noir-slide">
          <div class="noir-slide-layout-box">
            <div class="noir-slide-image-wrap">
              {% if block.settings.card_img_ruby != blank %}
                <img src="{{ block.settings.card_img_ruby | image_url: width: 1000 }}" alt="{{ block.settings.title_ruby | escape }}" class="luxury-card-img" loading="lazy">
              {% else %}
                <div class="luxury-card-fallback">
